# ──────────────────────────────────────────────
# TusCoach — Environment Variables
# Copy to .env and fill in values:
#   cp backend/.env.example backend/.env
# ──────────────────────────────────────────────

# ── Application ──
APP_NAME=TusCoach
APP_VERSION=0.1.0
ENV=dev                           # dev | prod

# ── Database (PostgreSQL) ──
# Dev default uses Docker on port 5433 (see dev.sh).
DATABASE_URL=postgresql://tuscoach:tuscoach123@localhost:5433/tuscoach

# ── Redis / Celery broker ──
REDIS_URL=redis://localhost:6379/0

# ── Authentication ──
# Generate a strong secret for production:
#   openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM (Gemini) ──
# REQUIRED for AI features: program generation, coaching messages, workflows.
# Get a free key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=                      # <-- paste your Gemini API key here
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── CORS ──
# JSON list of allowed origins.
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Push Notifications (Expo) ──
EXPO_ACCESS_TOKEN=                # Optional — leave empty to send without auth
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Streak ──
MIN_DAILY_MINUTES=10              # Minimum daily minutes to count toward streak
